# Shared CPU build modifier for library, executable, and installed input builds.
# Keep normal CPU/GPU builds unchanged unless memory checking is requested.
GKEYLL_USE_VALGRIND ?= 0
ifneq ($(GKEYLL_USE_VALGRIND),0)
ifneq ($(GKEYLL_USE_VALGRIND),1)
$(error GKEYLL_USE_VALGRIND must be 0 or 1)
endif
endif
ifeq ($(GKEYLL_USE_VALGRIND),1)
ifneq ($(strip $(USING_NVCC) $(filter nvcc nvc nvc++,$(notdir $(CC))) $(filter 1,$(USE_NCCL) $(USE_CUDSS))),)
$(error Valgrind requires a CPU build)
endif
# Use the compiler target, not the host CPU (also works with compiler wrappers).
VALGRIND_TARGET := $(shell $(CC) -dumpmachine)
ifneq ($(filter x86_64% amd64%,$(VALGRIND_TARGET)),)
VALGRIND_ARCH_FLAGS := -march=x86-64 -mtune=generic
else ifneq ($(filter aarch64% arm64%,$(VALGRIND_TARGET)),)
VALGRIND_ARCH_FLAGS := -march=armv8-a -mtune=generic
else
$(error No Valgrind build profile for compiler target $(VALGRIND_TARGET))
endif
# Remove existing machine options, including explicit instruction extensions.
override ARCH_FLAGS := $(VALGRIND_ARCH_FLAGS)
override CFLAGS := $(filter-out -m%,$(CFLAGS)) $(VALGRIND_ARCH_FLAGS) -g -gdwarf-4
override SQL_CFLAGS := $(filter-out -m%,$(SQL_CFLAGS)) $(VALGRIND_ARCH_FLAGS) -g -gdwarf-4
endif
export GKEYLL_USE_VALGRIND
