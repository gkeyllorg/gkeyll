import groovy.transform.Field
@Field def reporting

def loggedSh(String label, String command) { reporting.loggedSh(label, command) }
def timeCommand(String metric, String command) { reporting.timeCommand(metric, command) }

def loadReporting(Map settings) {
    def ref = env.CI_TRUSTED_CI_COMMIT?.trim() ?: env.GKEYLL_CI_TRUSTED_REF?.trim() ?: 'main'
    if (!(ref ==~ /[A-Za-z0-9][A-Za-z0-9._\/-]*/) || ref.contains('..') || ref.endsWith('.lock')) {
        error('Invalid trusted reporting ref.')
    }
    // This directory is outside the candidate checkout, which is deleted below.
    dir(pwd(tmp: true) + '/trusted-reporting') {
        deleteDir()
        withEnv(["CI_TRUSTED_REPORT_REF=${ref}"]) {
            sh '''#!/bin/bash
                set -euo pipefail
                git init --quiet
                git fetch --quiet --depth 1 https://github.com/gkeyllorg/gkeyll.git "$CI_TRUSTED_REPORT_REF"
                git show FETCH_HEAD:ci/jenkins/jenkins_reporting.groovy > jenkins_reporting.groovy
                git show FETCH_HEAD:ci/jenkins/github_report.py > github_report.py
                git show FETCH_HEAD:ci/jenkins/baseline_cache.sh > baseline_cache.sh
                chmod +x baseline_cache.sh
            '''
        }
        settings.reportingCommit = sh(returnStdout: true, script: 'git rev-parse FETCH_HEAD').trim()
        settings.cacheScript = pwd() + '/baseline_cache.sh'
        reporting = load('jenkins_reporting.groovy')
        reporting.configure(settings)
    }
}

// Manually selected local CI. Configure this trusted Pipeline job from main.
def ciParameters = [
    string(name: 'CANDIDATE_PR', defaultValue: '', trim: true,
        description: 'GitHub PR number; set this, or both reference fields.'),
    string(name: 'CANDIDATE_REF', defaultValue: '', trim: true,
        description: 'Candidate branch or full 40-character commit SHA.'),
    string(name: 'BASELINE_REF', defaultValue: '', trim: true,
        description: 'Baseline branch or full 40-character commit SHA.'),
    booleanParam(name: 'ALLOW_BEHIND_CANDIDATE', defaultValue: false,
        description: 'Allow a candidate that does not contain the baseline commit.')
]
if (env.CI_TEAM_WORKSTATION_BOOTSTRAPPED != 'true') {
    ciParameters += [string(name: 'CI_REF', defaultValue: '', trim: true,
        description: 'CI implementation branch or full SHA; blank uses GKEYLL_CI_TRUSTED_REF, then main. Independent of the candidate.')]
}
def jobProperties = [
    buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '20')),
    disableConcurrentBuilds(),
    parameters(ciParameters)
]
properties(jobProperties)

// Resolve the implementation once, before executing the selected Jenkinsfile.
// This also works for older implementations: they already honor the team
// bootstrap's CI_NODE_ALREADY_ALLOCATED and CI_TRUSTED_CI_COMMIT variables.
if (env.CI_TEAM_WORKSTATION_BOOTSTRAPPED == 'true') {
    if (params.CI_REF?.trim()) error('Team CI selects its implementation through TEAM_WORKSTATION_TRUSTED_CI_REF, not CI_REF.')
} else if (env.CI_PERSONAL_BOOTSTRAPPED != 'true') {
    def ciRef = validateRef('CI_REF', params.CI_REF?.trim() ?: env.GKEYLL_CI_TRUSTED_REF?.trim() ?: 'main')
    node(requireValue('PERSONAL_NODE_LABEL', env.PERSONAL_NODE_LABEL)) {
        def workspace = pwd()
        def trustedDir = pwd(tmp: true) + '/selected-ci'
        def ciCommit = ''
        stage('Load CI pipeline') {
            dir(trustedDir) {
                deleteDir()
                def refspec = isCommitSha(ciRef) ? ciRef : "refs/heads/${ciRef}"
                withEnv(["CI_SELECTED_REFSPEC=${refspec}"]) {
                    sh '''#!/bin/bash
                        set -euo pipefail
                        git init --quiet
                        git fetch --quiet --no-tags --depth 1 https://github.com/gkeyllorg/gkeyll.git "$CI_SELECTED_REFSPEC"
                        git checkout --quiet --detach FETCH_HEAD
                    '''
                }
                ciCommit = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
            }
            echo "CI Jenkinsfile: ci/jenkins/jenkinsfile.personal\nCI source ref: ${ciRef}\nCI source commit: ${ciCommit}"
        }
        withEnv(['CI_PERSONAL_BOOTSTRAPPED=true', 'CI_NODE_ALREADY_ALLOCATED=true',
                 "CI_TRUSTED_CI_REF=${ciRef}", "CI_TRUSTED_CI_COMMIT=${ciCommit}"]) {
            try {
                load "${trustedDir}/ci/jenkins/jenkinsfile.personal"
            } finally {
                // Older Jenkinsfiles replace the job parameters and delete the
                // workspace. Preserve both the selector and provenance even
                // when testing those versions, or when loading the script fails.
                properties(jobProperties)
                dir(workspace) {
                    writeFile file: 'ci-pipeline-source.txt', text: "jenkinsfile=ci/jenkins/jenkinsfile.personal\nref=${ciRef}\ncommit=${ciCommit}\n"
                    writeFile file: 'ci-trusted-ci-commit.txt', text: "${ciCommit}\n"
                    archiveArtifacts artifacts: 'ci-pipeline-source.txt,ci-trusted-ci-commit.txt'
                }
            }
        }
    }
    return
}

def requireValue(String name, String value) {
    value = value?.trim()
    if (!value) error("${name} must be configured in Jenkins.")
    value
}

def isCommitSha(String value) { value ==~ /[0-9a-fA-F]{40}/ }

def shortRef(String ref) { isCommitSha(ref) ? ref.take(7) : ref }

def validateBranchName(String name, String value) {
    if (!(value ==~ /[A-Za-z0-9][A-Za-z0-9._\/-]*/)
        || value.contains('..') || value.contains('//') || value.endsWith('/')
        || value.endsWith('.') || value.endsWith('.lock')) {
        error("${name} must be a safe branch name or full 40-character commit SHA, got '${value}'.")
    }
    value
}

def validateRef(String name, String value) {
    value = requireValue(name, value)
    isCommitSha(value) ? value.toLowerCase() : validateBranchName(name, value)
}

def checkoutRef(String ref, String localRef) {
    def refspec = isCommitSha(ref) ? "+${ref}:refs/remotes/origin/${localRef}" : "+refs/heads/${ref}:refs/remotes/origin/${localRef}"
    checkout([$class: 'GitSCM', branches: [[name: "refs/remotes/origin/${localRef}"]],
        doGenerateSubmoduleConfigurations: false,
        extensions: [[$class: 'CleanBeforeCheckout'], [$class: 'CloneOption', depth: 1, honorRefspec: true, noTags: true, shallow: true]],
        userRemoteConfigs: [[refspec: refspec, url: 'https://github.com/gkeyllorg/gkeyll.git']]])
}

def checkoutPullRequest(String number) {
    checkout([$class: 'GitSCM', branches: [[name: 'refs/remotes/origin/candidate']],
        doGenerateSubmoduleConfigurations: false,
        extensions: [[$class: 'CleanBeforeCheckout'], [$class: 'CloneOption', depth: 1, honorRefspec: true, noTags: true, shallow: true]],
        userRemoteConfigs: [[refspec: "+refs/pull/${number}/head:refs/remotes/origin/candidate", url: 'https://github.com/gkeyllorg/gkeyll.git']]])
}

def resolveRefCommit(String ref) {
    if (isCommitSha(ref)) return ref.toLowerCase()
    def commit = sh(returnStdout: true, script: "git ls-remote https://github.com/gkeyllorg/gkeyll.git refs/heads/${ref} | cut -f1 | head -n 1").trim()
    if (!(commit ==~ /[0-9a-f]{40}/)) error("Could not resolve baseline ref '${ref}' to a commit SHA.")
    commit
}

def baselineBehindCount(String statusCredentialsId, String baseline, String candidate) {
    withCredentials([usernamePassword(credentialsId: statusCredentialsId, usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'GITHUB_TOKEN')]) {
        withEnv(["CI_BASELINE_COMMIT=${baseline}", "CI_CANDIDATE_COMMIT=${candidate}"]) {
            return sh(returnStdout: true, script: '''#!/bin/bash
                set -euo pipefail
                curl --fail --silent --show-error --header 'Accept: application/vnd.github+json' --header "Authorization: Bearer $GITHUB_TOKEN" "https://api.github.com/repos/gkeyllorg/gkeyll/compare/$CI_BASELINE_COMMIT...$CI_CANDIDATE_COMMIT" | python3 -c 'import json,sys; print(json.load(sys.stdin)["behind_by"])'
            ''').trim().toInteger()
        }
    }
}

def pullRequestBase(String statusCredentialsId, String number) {
    def base = ''
    withCredentials([usernamePassword(credentialsId: statusCredentialsId, usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'GITHUB_TOKEN')]) {
        base = sh(returnStdout: true, script: """#!/bin/bash
            set -euo pipefail
            curl --fail --silent --show-error --header 'Accept: application/vnd.github+json' --header \"Authorization: Bearer \$GITHUB_TOKEN\" https://api.github.com/repos/gkeyllorg/gkeyll/pulls/${number} | python3 -c 'import json,sys; print(json.load(sys.stdin)["base"]["ref"])'
        """).trim()
    }
    validateBranchName('GitHub PR base branch', base)
}

def prepareTrustedRegressionChecker() {
    // The candidate must not choose the code that decides whether its results pass.
    // The team bootstrap supplies an exact reviewed commit; standalone jobs use
    // the same trusted ref as the report tool.
    def ref = validateRef('trusted CI ref', env.CI_TRUSTED_CI_COMMIT?.trim()
        ?: env.GKEYLL_CI_TRUSTED_REF?.trim() ?: 'main')
    def checker = "${env.WORKSPACE}/_trusted_check_regression_results.lua"
    withEnv(["CI_TRUSTED_CHECKER_REF=${ref}", "CI_TRUSTED_CHECKER_PATH=${checker}"]) {
        sh '''#!/bin/bash
            set -euo pipefail
            git fetch --quiet --depth 1 https://github.com/gkeyllorg/gkeyll.git "$CI_TRUSTED_CHECKER_REF"
            rm -f -- "$CI_TRUSTED_CHECKER_PATH"
            git show FETCH_HEAD:ci/jenkins/check_regression_results.lua > "$CI_TRUSTED_CHECKER_PATH"
            test -s "$CI_TRUSTED_CHECKER_PATH"
            git rev-parse FETCH_HEAD > ci-trusted-checker-commit.txt
        '''
    }
    return checker
}

// The config is supplied by the machine owner, outside disposable workspaces.
// Keep this helper in the trusted Pipeline so older candidate/baseline refs work.
def usePrebuiltConfig(String prefix) {
    def source = env.GKEYLL_CI_PREBUILT_CONFIG?.trim()
    if (!source) return false
    if (!source.startsWith('/') || !fileExists(source)) {
        error('GKEYLL_CI_PREBUILT_CONFIG must name an existing absolute config.mak path on the agent.')
    }
    def config = readFile(file: source)
    if (!(config =~ /(?m)^PREFIX\s*[:?]?=/)) {
        error('Prebuilt config.mak must define PREFIX and the paths for its dependencies.')
    }
    // Preserve dependency expressions relative to the original PREFIX, while
    // installing and linking Gkeyll itself exclusively inside this build.
    config = config.replaceAll(/(?m)^PREFIX(?=\s*[:?]?=)/, 'GKEYLL_CI_DEPENDENCY_PREFIX')
    config = config.replace('$(PREFIX)', '$(GKEYLL_CI_DEPENDENCY_PREFIX)')
        .replace('${PREFIX}', '${GKEYLL_CI_DEPENDENCY_PREFIX}')
    config += "\n# Jenkins workspace installation\noverride PREFIX := ${prefix}\noverride INSTALL_PREFIX := ${prefix}\n"
    writeFile file: 'config.mak', text: config
    // configure normally creates this second file too. Build before installing,
    // including with parallel make, and reuse the checkout's install recipes.
    writeFile file: 'alltargets.mak', text: '''.PHONY: all install
all: gkeyll
install: gkeyll
	$(MAKE) gkeyll-install
'''
    echo "Using prebuilt dependencies from ${source}; installing Gkeyll in ${prefix}"
    return true
}

def buildTree(String label, String prefix, String mkdeps, String configure, String jobs, String metricDirectory = '') {
    if (env.GKEYLL_CI_PREBUILT_CONFIG?.trim() &&
        !env.PERSONAL_MPIEXEC?.trim() && !env.PERSONAL_MPI_HOME?.trim()) {
        error('Prebuilt dependencies require PERSONAL_MPIEXEC or PERSONAL_MPI_HOME (TEAM_WORKSTATION_MPIEXEC or WORKSTATION_MPI_HOME for team CI).')
    }
    def mpiHome = env.PERSONAL_MPI_HOME?.trim() ?: "${prefix}/openmpi"
    withEnv(["PREFIX=${prefix}", "MPI_HOME=${mpiHome}"]) {
        if (!usePrebuiltConfig(prefix)) {
            loggedSh("${label}-setup", """#!/bin/bash
                set -euo pipefail
                ./machines/${mkdeps}
                ./machines/${configure}
            """)
        }
        timeCommand("${metricDirectory}${label}-unit-build-seconds.txt", "make -j${jobs} unit")
        timeCommand("${metricDirectory}${label}-unit-test-seconds.txt", "GKYL_UNIT_RESULTS='${env.WORKSPACE}/${label}-unit-results.txt' make unit-run")
        timeCommand("${metricDirectory}${label}-regression-build-seconds.txt", "make -j${jobs} regression")
        timeCommand("${metricDirectory}${label}-install-seconds.txt", "make -j${jobs} install")
    }
}

def createBaseline(String baseline, String baselineDir, String mkdeps, String configure, String jobs, String regressionJobs, String mpiExec) {
    dir("${baselineDir}/gkeyll") {
        checkoutRef(baseline, 'baseline')
        buildTree('baseline', "${baselineDir}/gkylsoft", mkdeps, configure, jobs, "${env.WORKSPACE}/")
        loggedSh("baseline-regression-configure", "\"${baselineDir}/gkylsoft/gkeyll/bin/gkeyll\" runregression configure --source-dir \"${baselineDir}/gkeyll\" --prefix \"${baselineDir}/gkylsoft\"")
        timeCommand("${env.WORKSPACE}/baseline-c-compile-seconds.txt", "\"${baselineDir}/gkylsoft/gkeyll/bin/gkeyll\" runregression run --c-only compile --jobs ${jobs}")
        timeCommand("${env.WORKSPACE}/baseline-c-regression-create-seconds.txt", "\"${baselineDir}/gkylsoft/gkeyll/bin/gkeyll\" runregression run --c-only --execute-only create --timeout 900 --jobs ${regressionJobs}")
        def mpiHome = env.PERSONAL_MPI_HOME?.trim()
        mpiExec = mpiExec ?: (mpiHome ? "${mpiHome}/bin/mpiexec" : '')
        def baselineMpiExec = mpiExec ?: "${baselineDir}/gkylsoft/openmpi/bin/mpiexec"
        loggedSh("baseline-parallel-regressions", """#!/bin/bash
            set -euo pipefail
            test -x "${baselineMpiExec}"
            "${baselineDir}/gkylsoft/gkeyll/bin/gkeyll" runregression configure --source-dir "${baselineDir}/gkeyll" --prefix "${baselineDir}/gkylsoft" --results-subdir parallel-c-4 --mpiexec "${baselineMpiExec}"
            started=\$(date +%s)
            "${baselineDir}/gkylsoft/gkeyll/bin/gkeyll" runregression run --c-only --parallel --jobs ${jobs} compile
            elapsed=\$(( \$(date +%s) - started ))
            printf '%s\\n' "\$elapsed" > "${env.WORKSPACE}/baseline-parallel-c-compile-seconds.txt"
            started=\$(date +%s)
            "${baselineDir}/gkylsoft/gkeyll/bin/gkeyll" runregression run --c-only --parallel --execute-only create
            elapsed=\$(( \$(date +%s) - started ))
            printf '%s\\n' "\$elapsed" > "${env.WORKSPACE}/baseline-parallel-c-regression-create-seconds.txt"
        """)
    }
}

def runCandidateRegressions(String candidateDir, String baselineDir, String jobs, String regressionJobs, String checker) {
    def gkeyll = "${candidateDir}/gkylsoft/gkeyll/bin/gkeyll"
    def baselineGkeyll = "${baselineDir}/gkylsoft/gkeyll/bin/gkeyll"
    def results = "${candidateDir}/gkylsoft/gkeyll-results"
    def baseline = "${baselineDir}/gkylsoft/gkeyll-results"
    loggedSh("candidate-regression-configure", "\"${gkeyll}\" runregression configure --source-dir \"${candidateDir}/gkeyll\" --prefix \"${candidateDir}/gkylsoft\"")
    timeCommand("${env.WORKSPACE}/candidate-c-compile-seconds.txt", "\"${gkeyll}\" runregression run --c-only compile --jobs ${jobs}")
    loggedSh("candidate-regression-check", """set -euo pipefail
        for layer in moments vlasov gyrokinetic pkpm; do
            if [ -d \"${baseline}/\$layer/creg-accepted\" ]; then
                rm -rf \"${results}/\$layer/creg-accepted\"
                ln -s \"${baseline}/\$layer/creg-accepted\" \"${results}/\$layer/creg-accepted\"
            fi
        done
        started=\$(date +%s)
        \"${gkeyll}\" runregression run --c-only --execute-only check --timeout 900 --jobs ${regressionJobs}
        elapsed=\$(( \$(date +%s) - started ))
        printf '%s\\n' "\$elapsed" > "${env.WORKSPACE}/candidate-c-regression-check-seconds.txt"
        echo "Candidate C-regression check runtime: \$elapsed seconds"
        cd \"${baselineDir}/gkeyll\"
        \"${baselineGkeyll}\" -S \"${checker}\" \\
          \"${results}\" \"${candidateDir}/gkeyll/ci/jenkins/expected_regression_diffs.txt\" \"${env.WORKSPACE}/ci-regression-summary.txt\" \\
          \"${baselineDir}/gkeyll/ci/jenkins/expected_regression_diffs.txt\" \"${baseline}\"
    """)
}

def runParallelRegressions(String candidateDir, String baselineDir, String mpiExec, String checker) {
    def mpiHome = env.PERSONAL_MPI_HOME?.trim()
    mpiExec = mpiExec ?: (mpiHome ? "${mpiHome}/bin/mpiexec" : '')
    def candidateMpiExec = mpiExec ?: "${candidateDir}/gkylsoft/openmpi/bin/mpiexec"
    def baselineMpiExec = mpiExec ?: "${baselineDir}/gkylsoft/openmpi/bin/mpiexec"
    def gkeyll = "${candidateDir}/gkylsoft/gkeyll/bin/gkeyll"
    def baselineGkeyll = "${baselineDir}/gkylsoft/gkeyll/bin/gkeyll"
    def results = "${candidateDir}/gkylsoft/gkeyll-results/parallel-c-4"
    def baselineResults = "${baselineDir}/gkylsoft/gkeyll-results/parallel-c-4"
    loggedSh("shared-parallel-regressions", """#!/bin/bash
        set -euo pipefail
        test -x "${candidateMpiExec}"
        test -x "${baselineMpiExec}"

        "${gkeyll}" runregression configure --source-dir "${candidateDir}/gkeyll" --prefix "${candidateDir}/gkylsoft" --results-subdir parallel-c-4 --mpiexec "${candidateMpiExec}"
        started=\$(date +%s)
        "${gkeyll}" runregression run --c-only --parallel --jobs ${env.PERSONAL_BUILD_JOBS ?: '3'} compile
        elapsed=\$(( \$(date +%s) - started ))
        printf '%s\\n' "\$elapsed" > "${env.WORKSPACE}/candidate-parallel-c-compile-seconds.txt"

        for layer in moments vlasov gyrokinetic pkpm; do
            if [ -d "${baselineResults}/\$layer/creg-accepted" ]; then
                rm -rf "${results}/\$layer/creg-accepted"
                ln -s "${baselineResults}/\$layer/creg-accepted" "${results}/\$layer/creg-accepted"
            fi
        done
        started=\$(date +%s)
        "${gkeyll}" runregression run --c-only --parallel --execute-only check
        elapsed=\$(( \$(date +%s) - started ))
        printf '%s\\n' "\$elapsed" > "${env.WORKSPACE}/candidate-parallel-c-regression-check-seconds.txt"
        cd "${baselineDir}/gkeyll"
        "${baselineGkeyll}" -S "${checker}" \\
          "${results}" "${candidateDir}/gkeyll/ci/jenkins/expected_regression_diffs.txt" "${env.WORKSPACE}/ci-parallel-regression-summary.txt" \\
          "${baselineDir}/gkeyll/ci/jenkins/expected_regression_diffs.txt" "${baselineResults}"
    """)
}

def writeCiTimingSummary() {
    sh '''#!/bin/bash
        set -euo pipefail

        metric() {
            local file="$1"
            if [[ -f "$file" ]]; then
                local value
                value="$(tr -d '[:space:]' < "$file")"
                if [[ -n "$value" ]]; then
                    printf '%s' "$value"
                    return
                fi
            fi
            printf 'not-recorded'
        }

        candidate_unit_build="$(metric candidate-unit-build-seconds.txt)"
        baseline_unit_build="$(metric baseline-unit-build-seconds.txt)"
        candidate_unit_test="$(metric candidate-unit-test-seconds.txt)"
        baseline_unit_test="$(metric baseline-unit-test-seconds.txt)"
        candidate_regression_build="$(metric candidate-regression-build-seconds.txt)"
        baseline_regression_build="$(metric baseline-regression-build-seconds.txt)"
        candidate_install="$(metric candidate-install-seconds.txt)"
        baseline_install="$(metric baseline-install-seconds.txt)"
        candidate_compile="$(metric candidate-c-compile-seconds.txt)"
        baseline_compile="$(metric baseline-c-compile-seconds.txt)"
        candidate_parallel_compile="$(metric candidate-parallel-c-compile-seconds.txt)"
        baseline_parallel_compile="$(metric baseline-parallel-c-compile-seconds.txt)"
        regression_create="$(metric baseline-c-regression-create-seconds.txt)"
        regression_check="$(metric candidate-c-regression-check-seconds.txt)"
        parallel_regression_create="$(metric baseline-parallel-c-regression-create-seconds.txt)"
        parallel_regression_check="$(metric candidate-parallel-c-regression-check-seconds.txt)"
        baseline_cache_status="$(awk -F= '$1 == "status" {print $2; exit}' ci-baseline-cache.txt 2>/dev/null || true)"
        baseline_cache_status="${baseline_cache_status:-not-recorded}"

        {
            printf 'baseline_cache_status=%s\n' "$baseline_cache_status"
            printf 'candidate_unit_build_seconds=%s\n' "$candidate_unit_build"
            printf 'baseline_unit_build_seconds=%s\n' "$baseline_unit_build"
            printf 'candidate_unit_test_seconds=%s\n' "$candidate_unit_test"
            printf 'baseline_unit_test_seconds=%s\n' "$baseline_unit_test"
            printf 'candidate_regression_build_seconds=%s\n' "$candidate_regression_build"
            printf 'baseline_regression_build_seconds=%s\n' "$baseline_regression_build"
            printf 'candidate_install_seconds=%s\n' "$candidate_install"
            printf 'baseline_install_seconds=%s\n' "$baseline_install"
            printf 'candidate_c_compile_seconds=%s\n' "$candidate_compile"
            printf 'baseline_c_compile_seconds=%s\n' "$baseline_compile"
            printf 'candidate_parallel_c_compile_seconds=%s\n' "$candidate_parallel_compile"
            printf 'baseline_parallel_c_compile_seconds=%s\n' "$baseline_parallel_compile"
            printf 'baseline_c_regression_create_seconds=%s\n' "$regression_create"
            printf 'candidate_c_regression_check_seconds=%s\n' "$regression_check"
            printf 'baseline_parallel_c_regression_create_seconds=%s\n' "$parallel_regression_create"
            printf 'candidate_parallel_c_regression_check_seconds=%s\n' "$parallel_regression_check"
        } > ci-timing-summary.txt
        cat ci-timing-summary.txt
    '''
}

def candidatePr = params.CANDIDATE_PR?.trim() ?: env.CI_CANDIDATE_PR?.trim()
def candidateRef = params.CANDIDATE_REF?.trim() ?: env.CI_CANDIDATE_REF?.trim()
def queuedCommit = params.CI_QUEUE_COMMIT?.trim()
if (queuedCommit && !isCommitSha(queuedCommit)) error('CI_QUEUE_COMMIT must be a full commit SHA.')
def requestedBaseline = params.BASELINE_REF?.trim() ?: env.CI_BASELINE_REF?.trim()
if (!!candidatePr == !!candidateRef) error('Set exactly one of CANDIDATE_PR or CANDIDATE_REF.')
if (candidatePr && !(candidatePr ==~ /[1-9][0-9]*/)) error("CANDIDATE_PR must be a positive integer, got '${candidatePr}'.")
if (candidatePr && requestedBaseline) error('BASELINE_REF must be empty with CANDIDATE_PR.')
if (candidateRef) { candidateRef = validateRef('CANDIDATE_REF', candidateRef); requestedBaseline = validateRef('BASELINE_REF', requestedBaseline) }
def allowBehindCandidate = params.ALLOW_BEHIND_CANDIDATE || env.CI_ALLOW_BEHIND_CANDIDATE == 'true'

def label = requireValue('PERSONAL_NODE_LABEL', env.PERSONAL_NODE_LABEL)
def mkdeps = env.GKEYLL_CI_PREBUILT_CONFIG?.trim() ? '' : validateBranchName('PERSONAL_MKDEPS_SCRIPT', requireValue('PERSONAL_MKDEPS_SCRIPT', env.PERSONAL_MKDEPS_SCRIPT))
def configure = env.GKEYLL_CI_PREBUILT_CONFIG?.trim() ? '' : validateBranchName('PERSONAL_CONFIGURE_SCRIPT', requireValue('PERSONAL_CONFIGURE_SCRIPT', env.PERSONAL_CONFIGURE_SCRIPT))
def statusCredentialsId = requireValue('PERSONAL_GITHUB_CREDENTIAL_ID', env.PERSONAL_GITHUB_CREDENTIAL_ID)
def jobs = (env.PERSONAL_BUILD_JOBS ?: '3').trim()
def regressionJobs = (env.PERSONAL_REGRESSION_JOBS ?: env.PERSONAL_BUILD_JOBS ?: '3').trim()
def mpiExec = (env.PERSONAL_MPIEXEC ?: '').trim()
def gkeyllCiRoot = requireValue('GKEYLL_CI_ROOT', env.GKEYLL_CI_ROOT)
if (!(jobs ==~ /[1-9][0-9]*/) || !(regressionJobs ==~ /[1-9][0-9]*/)) error('PERSONAL_BUILD_JOBS and PERSONAL_REGRESSION_JOBS must be positive integers.')

def ciStage(String name, Closure body) { reporting.ciStage(name, body) }

def writeCiFailureSummary(String result, String name, String message) { reporting.writeCiFailureSummary(result, name, message) }

def runCi = {
    def commit = queuedCommit ?: (isCommitSha(candidateRef ?: '') ? candidateRef : '')
    def baselineCommit = ''
    def status = 'failure'
    def description = 'Personal CI failed.'
    def failureMessage = ''
    def platform = env.CI_PLATFORM?.trim() ?: 'personal'
    def cachePlatform = platform == 'team' ? 'team-workstation' : platform
    def baselineDir = ''
    def baselineStage = ''
    def candidateDir = ''
    def trustedChecker = ''
    def baselineCacheHit = false
    // Every controller needs its own status context, otherwise two machines
    // testing the same commit overwrite each other's status on GitHub.
    def statusContext = params.CI_QUEUE_CONTEXT?.trim() ?: env.CI_STATUS_CONTEXT?.trim() ?: env.PERSONAL_STATUS_CONTEXT?.trim()
    if (!statusContext) {
        def host = sh(returnStdout: true, script: 'hostname -s 2>/dev/null || hostname').trim().toLowerCase().replaceAll(/[^a-z0-9._-]/, '-')
        statusContext = "continuous-integration/jenkins/personal-${host ?: 'unknown'}"
    }
    loadReporting([credential: statusCredentialsId, context: statusContext, platform: platform,
        pr: candidatePr ?: '', ref: candidateRef ?: '', commit: commit])
    def cacheScript = reporting.settings.cacheScript
    try {
        ciStage('Resolve candidate and baseline') {
            currentBuild.displayName = "#${env.BUILD_NUMBER} ${candidatePr ? "PR-${candidatePr}" : shortRef(candidateRef)}"
            if (candidatePr) { candidateRef = "PR #${candidatePr}"; requestedBaseline = pullRequestBase(statusCredentialsId, candidatePr) }
            currentBuild.description = "${shortRef(candidateRef)} vs ${shortRef(requestedBaseline)}"
        }
        ciStage('Checkout candidate') {
            deleteDir()
            // Report and test the exact commit accepted by the controller's queue listener.
            if (queuedCommit) checkoutRef(queuedCommit, 'candidate')
            else if (candidatePr) checkoutPullRequest(candidatePr)
            else checkoutRef(candidateRef, 'candidate')
            commit = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
            reporting.settings.commit = commit
            writeFile file: 'ci-candidate-commit.txt', text: "${commit}\n"
            // Written after deleteDir() above so it survives into the artifacts and report.
            currentBuild.description += " @ ${commit.take(7)}"
            if (env.CI_TRUSTED_CI_COMMIT?.trim()) {
                writeFile file: 'ci-trusted-ci-commit.txt', text: "${env.CI_TRUSTED_CI_COMMIT.trim()}\n"
            }
        }
        ciStage('Verify candidate contains baseline') {
            baselineCommit = resolveRefCommit(requestedBaseline)
            def behind = baselineBehindCount(statusCredentialsId, baselineCommit, commit)
            writeFile file: 'ci-baseline-preflight.txt', text: "candidate_commit=${commit}\nbaseline_selector=${requestedBaseline}\nbaseline_commit=${baselineCommit}\nbehind_by=${behind}\noverride=${allowBehindCandidate}\n"
            writeFile file: 'ci-selection.txt', text: "candidate_selector=${candidateRef}\nbaseline_selector=${requestedBaseline}\ncandidate_commit=${commit}\nbaseline_commit=${baselineCommit}\nallow_behind=${allowBehindCandidate}\n"
            if (behind > 0 && !allowBehindCandidate) {
                error("Candidate ${commit.take(7)} is behind baseline ${baselineCommit.take(7)} by ${behind} commit(s); merge or rebase the baseline, or set ALLOW_BEHIND_CANDIDATE for an intentional historical comparison.")
            }
            if (behind > 0) echo("WARNING: allowing candidate behind baseline by ${behind} commit(s).")
            requestedBaseline = baselineCommit
        }
        ciStage('Prepare candidate build') {
            candidateDir = sh(returnStdout: true, script: "'${cacheScript}' prepare-candidate '${gkeyllCiRoot}' '${cachePlatform}' '${commit}' '${env.WORKSPACE}' '${baselineCommit}'").trim()
        }
        reporting.progress('Gkeyll CI is running.')
        ciStage('Build candidate') { dir("${candidateDir}/gkeyll") { buildTree('candidate', "${candidateDir}/gkylsoft", mkdeps, configure, jobs, "${env.WORKSPACE}/") } }
        ciStage('Resolve baseline cache') {
            baselineDir = sh(returnStdout: true, script: "'${cacheScript}' baseline-path '${gkeyllCiRoot}' '${cachePlatform}' '${baselineCommit}'").trim()
            baselineCacheHit = sh(returnStatus: true, script: "'${cacheScript}' valid '${gkeyllCiRoot}' '${cachePlatform}' '${baselineCommit}'") == 0
            if (!baselineCacheHit) baselineStage = sh(returnStdout: true, script: "'${cacheScript}' prepare-baseline '${gkeyllCiRoot}' '${cachePlatform}' '${baselineCommit}'").trim()
            writeFile file: 'ci-baseline-cache.txt', text: "status=${baselineCacheHit ? 'hit' : 'miss'}\nplatform=${cachePlatform}\nbaseline_commit=${baselineCommit}\npath=${baselineCacheHit ? baselineDir : baselineStage}\n"
        }
        if (!baselineCacheHit) {
            ciStage('Build baseline cache') {
                createBaseline(requestedBaseline, baselineStage, mkdeps, configure, jobs, regressionJobs, mpiExec)
                sh """#!/bin/bash
                    set -euo pipefail
                    cat > '${baselineStage}/cache-manifest.txt' <<EOF
format_version=1
platform=${cachePlatform}
baseline_commit=${baselineCommit}
created_utc=\$(date -u +%Y-%m-%dT%H:%M:%SZ)
serial_c_results=present
parallel_c_4_results=present
EOF
                """
                baselineDir = sh(returnStdout: true, script: "'${cacheScript}' publish-baseline '${gkeyllCiRoot}' '${cachePlatform}' '${baselineCommit}' '${baselineStage}' '${env.WORKSPACE}'").trim()
                writeFile file: 'ci-baseline-cache.txt', text: "status=miss\nplatform=${cachePlatform}\nbaseline_commit=${baselineCommit}\npath=${baselineDir}\n"
            }
        }
        ciStage('Record baseline cache') { sh "git -C '${baselineDir}/gkeyll' rev-parse HEAD | tee ci-baseline-commit.txt" }
        ciStage('Prepare trusted regression checker') { trustedChecker = prepareTrustedRegressionChecker() }
        ciStage('C regressions') { dir("${candidateDir}/gkeyll") { runCandidateRegressions(candidateDir, baselineDir, jobs, regressionJobs, trustedChecker) } }
        ciStage('Parallel C regressions') { dir("${candidateDir}/gkeyll") { runParallelRegressions(candidateDir, baselineDir, mpiExec, trustedChecker) }; status = 'success'; description = 'Personal CI passed.' }
    } catch (err) {
        failureMessage = err.toString()
        status = reporting.failureResult(err, currentBuild.currentResult)
        if (status in ['cancelled', 'timed_out']) description = "Personal CI ${status}."
        throw err
    } finally {
        try {
            writeCiTimingSummary()
        } catch (err) {
            status = 'error'
            description = 'Personal CI timing summary failed.'
            if (!failureMessage) {
                failureMessage = err.toString()
                env.CI_FAILURE_STAGE = 'Write CI timing summary'
            } else {
                failureMessage += " | Timing summary also failed: ${err}"
            }
            currentBuild.result = 'FAILURE'
            echo "WARNING: could not write CI timings: ${err}"
        } finally {
            try {
                if (candidateDir) sh "'${cacheScript}' stage-candidate-artifacts '${gkeyllCiRoot}' '${cachePlatform}' '${commit}' '${env.WORKSPACE}' '${baselineCommit}'"
            } catch (err) {
                echo "WARNING: could not stage CI report artifacts: ${err}"
            }
            if (status != 'success') writeCiFailureSummary(status, env.CI_FAILURE_STAGE, failureMessage ?: description)
            // Best effort: a GitHub outage must not turn a passing build red.
            // Keep the full report locally if both GitHub transports are unavailable.
            def reportError = ''
            if (commit || candidatePr || candidateRef) {
                try {
                    def summaryLine = reporting.publish(status, description, true)
                    if (summaryLine) description = summaryLine.take(140)
                } catch (err) {
                    reportError = err.toString()
                    echo "WARNING: could not publish the GitHub CI report: ${reportError}"
                }
            }
            archiveArtifacts allowEmptyArchive: true, artifacts: 'ci-trusted-ci-commit.txt,ci-reporting-commit.txt,ci-selection.txt,ci-baseline-preflight.txt,ci-baseline-cache.txt,ci-trusted-checker-commit.txt,ci-candidate-commit.txt,ci-baseline-commit.txt,*-seconds.txt,*-unit-results.txt,candidate-*.log,baseline-*.log,ci-failure-detail.txt,ci-report*.md,ci-report*.md.json,ci-report-delivery.json,ci-diagnostic-summary.json,ci-stage-history.txt,ci-command-logs/**,ci-timing-summary.txt,ci-regression-summary.txt,ci-parallel-regression-summary.txt,ci-failure-summary.txt,build/**/*.log,cuda-build/**/*.log,_baseline/build/**/*.log,_baseline/cuda-build/**/*.log,_baseline/gkylsoft/gkeyll-results/**/regressiondb,_baseline/gkylsoft/gkeyll-results/**/_rr_failures.txt,gkylsoft/gkeyll-results/**/regressiondb,gkylsoft/gkeyll-results/**/_rr_failures.txt'
            if (reportError) description = "${description} (report not posted)".take(140)
        }
        if (candidateDir && baselineCommit) {
            sh "'${cacheScript}' finalize-candidate '${gkeyllCiRoot}' '${cachePlatform}' '${commit}' '${baselineCommit}' '${status}' '${env.CI_FAILURE_STAGE ?: ''}' '${env.WORKSPACE}'"
        }
        deleteDir()
    }
}

// The team-workstation inline bootstrap already owns the agent while it
// checks out this trusted workflow from main. Reusing that allocation avoids
// a nested node() request, which can deadlock a one-executor workstation.
if (env.CI_NODE_ALREADY_ALLOCATED == 'true') {
    runCi()
} else {
    node(label) {
        runCi()
    }
}
