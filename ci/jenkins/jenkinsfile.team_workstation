// Trusted team-workstation workflow. Production Jenkins must load this file
// only through the inline bootstrap documented in README.team_workstation.md:
// that bootstrap checks out main into _trusted_ci before loading this script.
// Do not configure this path as a normal multibranch Jenkinsfile: in that
// mode a PR would be able to replace the Pipeline that controls CI.
if (env.CI_TEAM_WORKSTATION_BOOTSTRAPPED != 'true') {
    error('This workflow must be loaded by the trusted team-workstation inline bootstrap; see ci/jenkins/README.team_workstation.md.')
}

def explicitSelector = params.CANDIDATE_PR?.trim() || params.CANDIDATE_REF?.trim() || params.BASELINE_REF?.trim()
if (!explicitSelector && env.BRANCH_NAME != 'main' && !env.CHANGE_ID) {
    echo "Skipping non-PR branch '${env.BRANCH_NAME}'."
    return
}

def forwarded = [
    "CI_STATUS_CONTEXT=${env.TEAM_WORKSTATION_STATUS_CONTEXT ?: 'continuous-integration/jenkins/team-workstation'}",
    'CI_NODE_ALREADY_ALLOCATED=true',
    "PERSONAL_NODE_LABEL=${env.TEAM_WORKSTATION_NODE_LABEL ?: ''}",
    "PERSONAL_MKDEPS_SCRIPT=${env.TEAM_WORKSTATION_MKDEPS_SCRIPT ?: ''}",
    "PERSONAL_CONFIGURE_SCRIPT=${env.TEAM_WORKSTATION_CONFIGURE_SCRIPT ?: ''}",
    "PERSONAL_GITHUB_CREDENTIAL_ID=${env.TEAM_WORKSTATION_GITHUB_CREDENTIAL_ID ?: ''}",
    "PERSONAL_BUILD_JOBS=${env.TEAM_WORKSTATION_BUILD_JOBS ?: '3'}",
    "PERSONAL_REGRESSION_JOBS=${env.TEAM_WORKSTATION_REGRESSION_JOBS ?: '1'}"
]
if (!explicitSelector && env.CHANGE_ID) {
    if (env.CHANGE_TARGET != 'main') {
        echo "Skipping PR #${env.CHANGE_ID}: target '${env.CHANGE_TARGET}' is not main."
        return
    }
    forwarded += ["CI_CANDIDATE_PR=${env.CHANGE_ID}"]
} else if (!explicitSelector && env.BRANCH_NAME == 'main') {
    // Keep main visible and testable without accepting an unreviewed branch.
    forwarded += ['CI_CANDIDATE_REF=main', 'CI_BASELINE_REF=main']
}

withEnv(forwarded) {
    // This absolute path remains valid after entering the candidate workspace.
    // It is deliberately the bootstrap's main checkout, never the PR checkout.
    load "${env.TRUSTED_CI_DIR}/ci/jenkins/jenkinsfile.personal"
}
